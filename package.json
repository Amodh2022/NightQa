{
  "name": "nightqa",
  "version": "0.1.0",
  "private": true,
  "description": "Self-healing QA agent for AI-written software",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "nightqa": "./dist/cli.js"
  },
  "scripts": {
    "nightqa": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "zoo": "tsx zoo/server.ts",
    "eval": "tsx eval/run.ts --mode real",
    "eval:pipeline": "tsx eval/run.ts --mode scripted",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "msw": "^3.0.3",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@octokit/rest": "^22.0.1",
    "pino": "^10.4.0",
    "playwright": "^1.64.1",
    "ulid": "^3.0.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "packageManager": "pnpm@12.14.0",
  "lint-staged": {
    "*.{ts,js,mjs,json,md,yml,yaml}": "prettier --write",
    "*.{ts,js}": "eslint --fix --max-warnings 0 --no-warn-ignored"
  }
}
