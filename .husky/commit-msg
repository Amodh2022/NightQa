# Conventional Commits: type(scope)?: subject
msg_file="$1"
first_line=$(head -n 1 "$msg_file")
if ! echo "$first_line" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9-]+\))?!?: .+'; then
  echo "Commit message must follow Conventional Commits, e.g. 'feat(agent): add budgets'."
  echo "Got: $first_line"
  exit 1
fi
