# Copy to .env and fill in. Never commit .env (it is git-ignored).

# --- AI (required for `nightqa run`; not needed for `nightqa replay`) ---
# nvidia (OpenAI-compatible, build.nvidia.com) or anthropic
NIGHTQA_PROVIDER=nvidia
NVIDIA_API_KEY=                # paste your key here (starts with nvapi-)
NIGHTQA_MODEL_STRONG=meta/muse-glimmer-30b
# Optional. Free trial models have no price, so cost shows as $0 (step and time budgets still apply).
# For Anthropic these two are required: USD per million tokens.
NIGHTQA_PRICE_STRONG_INPUT_PER_MTOK=
NIGHTQA_PRICE_STRONG_OUTPUT_PER_MTOK=
NIGHTQA_TEMPERATURE=0.2        # nvidia only; Anthropic models reject sampling parameters
# Anthropic alternative:
# NIGHTQA_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# NIGHTQA_EFFORT=low           # anthropic only: low | medium | high | xhigh | max

# --- Per-flow budgets (defaults shown). Going over any one ends the run as agent_stuck. ---
NIGHTQA_MAX_STEPS=40
NIGHTQA_MAX_SECONDS=300
NIGHTQA_MAX_COST_USD=0.50

# --- Test accounts: a flow says `login: test-buyer`, the secrets live here, never in YAML. ---
# Name is upper-cased, non-alphanumerics become underscores: test-buyer -> TEST_BUYER
NIGHTQA_ACCOUNT_TEST_BUYER_USERNAME=
NIGHTQA_ACCOUNT_TEST_BUYER_PASSWORD=

# --- Logging ---
NIGHTQA_LOG_LEVEL=info

# --- Bug zoo demo shop (pnpm zoo) ---
# all | none | comma list such as B01,B04
ZOO_BUGS=all
ZOO_TEST_USER=test-buyer@example.com
ZOO_TEST_PASSWORD=zoo-pass
PORT=4010
