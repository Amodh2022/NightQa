# Copy to .env and fill in. Never commit .env (it is git-ignored).

# --- AI (required for `nightqa run`; not needed for `nightqa replay`) ---
# nvidia (OpenAI-compatible, build.nvidia.com) or anthropic
NIGHTQA_PROVIDER=nvidia
NVIDIA_API_KEY=                # paste your key here (starts with nvapi-)
NIGHTQA_MODEL_STRONG=meta/muse-glimmer-30b
# Optional. Free trial models have no price, so cost shows as $0 (step and time budgets still apply).
# For Anthropic these two are required: USD per million tokens.
NIGHTQA_PRICE_STRONG_INPUT_PER_MTOK=
NIGHTQA_PRICE_STRONG_OUTPUT_PER_MTOK=
NIGHTQA_TEMPERATURE=0.2        # nvidia only; Anthropic models reject sampling parameters
# Anthropic alternative:
# NIGHTQA_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# NIGHTQA_EFFORT=low           # anthropic only: low | medium | high | xhigh | max

# --- Per-flow budgets (defaults shown). Going over any one ends the run as agent_stuck. ---
NIGHTQA_MAX_STEPS=40
NIGHTQA_MAX_SECONDS=300
NIGHTQA_MAX_COST_USD=0.50

# --- Reporting bugs to GitHub (optional). Without a repo, proven bugs are saved but not filed. ---
# GITHUB_TOKEN: fine-grained token on that one repository, permission "Issues: Read and write" and nothing else.
NIGHTQA_GITHUB_REPO=           # owner/name
GITHUB_TOKEN=
NIGHTQA_MIN_SEVERITY=medium    # low | medium | high | critical: files bugs at or above this
NIGHTQA_FIX_PRS=auto           # auto: @claude fix request for High/Critical | manual | off
NIGHTQA_MAX_FIX_PRS=3          # fix requests per night
NIGHTQA_MAX_BUGS_PER_RUN=5     # more are recorded but not investigated

# --- Test accounts: a flow says `login: test-buyer`, the secrets live here, never in YAML. ---
# Name is upper-cased, non-alphanumerics become underscores: test-buyer -> TEST_BUYER
NIGHTQA_ACCOUNT_TEST_BUYER_USERNAME=
NIGHTQA_ACCOUNT_TEST_BUYER_PASSWORD=

# --- Docker (docker compose up) ---
# Make files in ./results and ./tests/nightqa belong to you:  NIGHTQA_UID=$(id -u)  NIGHTQA_GID=$(id -g)
NIGHTQA_UID=1000
NIGHTQA_GID=1000
NIGHTQA_WEB_PORT=3300
NIGHTQA_ZOO_PORT=4010
# Listen address for the published ports. Keep 127.0.0.1 unless sign-in is on and you mean to share it.
NIGHTQA_BIND=127.0.0.1
# Timezone for times shown in the dashboard (IANA name). The container runs in UTC otherwise.
NIGHTQA_TZ=Asia/Kolkata

# --- Database (Postgres holds run and bug metadata; evidence stays in ./results) ---
# docker compose starts it for you. Choose your own password (letters and digits only, it goes into a URL).
POSTGRES_PASSWORD=
# Only for running outside compose (then `nightqa db migrate` creates the tables). Blank = file storage.
DATABASE_URL=
# NIGHTQA_DB_POOL_MAX=5
# NIGHTQA_DB_CONNECT_TIMEOUT_MS=5000
# NIGHTQA_DB_STATEMENT_TIMEOUT_MS=15000

# --- Dashboard sign-in. Turn on at least one method; the login page shows the ones that are set up. ---
# Without a complete method the dashboard shows nothing but a setup page.
NIGHTQA_PUBLIC_URL=http://localhost:3300
# Session secret (all methods): openssl rand -base64 48
NIGHTQA_SESSION_SECRET=

# Method 1: GitHub. github.com/settings/developers -> New OAuth App. Callback URL: <NIGHTQA_PUBLIC_URL>/api/auth/callback
NIGHTQA_GITHUB_CLIENT_ID=
NIGHTQA_GITHUB_CLIENT_SECRET=
# Who may sign in (GitHub logins, comma separated). Members can run things; viewers can only look.
NIGHTQA_AUTH_USERS=
NIGHTQA_AUTH_VIEWERS=
# Or everyone in a GitHub organization (members):
# NIGHTQA_AUTH_ORG=

# Method 2: your own SSO (OpenID Connect): Keycloak, Authentik, Authelia, Zitadel, Okta, Azure AD, Google, ...
# Create a client in your provider (authorization code flow). Redirect URI: <NIGHTQA_PUBLIC_URL>/api/auth/oidc/callback
# NIGHTQA_OIDC_ISSUER=https://sso.example.com/realms/acme   # must be https (or localhost)
# NIGHTQA_OIDC_CLIENT_ID=
# NIGHTQA_OIDC_CLIENT_SECRET=
# NIGHTQA_OIDC_NAME=Acme SSO                 # text on the button
# Who may sign in. Set at least one. Groups come from the token claim NIGHTQA_OIDC_GROUPS_CLAIM (default: groups).
# NIGHTQA_OIDC_ALLOWED_EMAILS=dana@acme.io,sam@acme.io
# NIGHTQA_OIDC_ALLOWED_DOMAINS=acme.io
# NIGHTQA_OIDC_MEMBER_GROUPS=qa-team
# NIGHTQA_OIDC_VIEWER_GROUPS=qa-viewers
# NIGHTQA_OIDC_DEFAULT_ROLE=member            # role for people allowed by email or domain: member | viewer

# Method 3: email + password (needs the database above). Add more people in Settings -> Team.
# NIGHTQA_PASSWORD_AUTH=1
# The first member, created when there are no accounts yet. Remove both lines after your first sign-in.
# NIGHTQA_BOOTSTRAP_EMAIL=you@example.com
# NIGHTQA_BOOTSTRAP_PASSWORD=             # at least 12 characters

# Local development ONLY: switch sign-in off entirely.
# NIGHTQA_AUTH=off

# --- Testing a production-looking URL / an app with a separate API host (operator consent, server env only) ---
# The dashboard never lets a web request switch these on. Off by default.
# NIGHTQA_ALLOW_PRODUCTION=1
# NIGHTQA_ALLOW_ORIGINS=https://api.example.com,https://cdn.example.com

# --- Dashboard storage ---
# Encrypts the secrets you save in Settings (test accounts, GitHub token, Slack/SMTP). Without it nothing is stored.
# Keep it safe: losing it means re-entering them. openssl rand -base64 32
NIGHTQA_SECRET_KEY=
# Set to 1 only behind a reverse proxy you run: lets sign-in rate limiting use X-Forwarded-For.
# NIGHTQA_TRUST_PROXY=1

# --- Logging ---
NIGHTQA_LOG_LEVEL=info

# --- Bug zoo demo shop (pnpm zoo) ---
# all | none | comma list such as B01,B04
ZOO_BUGS=all
ZOO_TEST_USER=test-buyer@example.com
ZOO_TEST_PASSWORD=zoo-pass
ZOO_PORT=4010
